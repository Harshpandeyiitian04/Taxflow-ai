# Supabase — get from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJ_YOUR_SERVICE_ROLE_KEY

# Google Gemini AI — get from aistudio.google.com
GEMINI_API_KEY=AIza_YOUR_GEMINI_KEY

# Resend email — get from resend.com
# RESEND_FROM_EMAIL is required to send mail (no fallback address).
# Must be a verified domain on Resend; gmail.com From addresses will fail.
RESEND_API_KEY=re_YOUR_RESEND_KEY
RESEND_FROM_EMAIL=

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Loom demo embed (optional)
NEXT_PUBLIC_LOOM_DEMO_URL=

# Public support contact (optional; hide footer line if empty)
NEXT_PUBLIC_SUPPORT_EMAIL=

# WhatsApp reminders (optional; WATI account required)
WATI_API_KEY=
WATI_API_ENDPOINT=
CRON_SECRET=

# Fair-use / abuse limits (free early access)
FAIR_USE_DAILY_EXTRACTIONS=300
MAX_CLIENTS_PER_FIRM=1000
MAX_UPLOADS_PER_TOKEN=12
MAX_UPLOAD_MB=4

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
