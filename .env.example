# Neon Postgres — pooled URL for the app, direct URL for migrations
# Until security cutover: DATABASE_URL may still be the owner role.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Restricted runtime role (taxflow_app, NOBYPASSRLS) — set after migration 002
DATABASE_URL_APP=
# Optional explicit admin/migrator URL (defaults to UNPOOLED/DATABASE_URL)
DATABASE_URL_ADMIN=
# Set to 1 only after DATABASE_URL_APP is live and verified
TAXFLOW_RLS_ENFORCED=0

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://YOUR_NEON_AUTH_HOST/YOUR_DB/auth
NEON_AUTH_JWKS_URL=https://YOUR_NEON_AUTH_HOST/YOUR_DB/auth/.well-known/jwks.json
# At least 32 characters; generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (S3-compatible, private "documents" bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL_S3=
NEON_STORAGE_BUCKET=documents

# Supabase — REMOVED. TaxFlow AI now runs on Neon; these variables are no longer read.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI — get from aistudio.google.com
GEMINI_API_KEY=AIza_YOUR_GEMINI_KEY

# Resend email — get from resend.com
# RESEND_FROM_EMAIL is required to send mail (no fallback address).
# Must be a verified domain on Resend; gmail.com From addresses will fail.
RESEND_API_KEY=re_YOUR_RESEND_KEY
RESEND_FROM_EMAIL=

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Loom demo embed (optional)
NEXT_PUBLIC_LOOM_DEMO_URL=

# Public support contact (optional; hide footer line if empty)
NEXT_PUBLIC_SUPPORT_EMAIL=

# WhatsApp reminders (optional; WATI account required)
WATI_API_KEY=
WATI_API_ENDPOINT=
CRON_SECRET=

# Fair-use / abuse limits (free early access)
FAIR_USE_DAILY_EXTRACTIONS=300
MAX_CLIENTS_PER_FIRM=1000
MAX_UPLOADS_PER_TOKEN=12
MAX_UPLOAD_MB=4

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
